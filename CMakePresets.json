{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "mac-debug",
      "displayName": "macOS Debug (native arch)",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "mac-asan",
      "displayName": "macOS Debug + Address/UB sanitizers",
      "inherits": "mac-debug",
      "cacheVariables": { "RADIFF_ENABLE_ASAN": "ON" }
    },
    {
      "name": "mac-release",
      "displayName": "macOS Release (native arch)",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "mac-universal-release",
      "displayName": "macOS Release Universal (arm64 + x86_64)",
      "inherits": "mac-release",
      "cacheVariables": { "RADIFF_UNIVERSAL": "ON" }
    },
    {
      "name": "mac-xcode",
      "displayName": "macOS Xcode project (for debugging plug-ins in a DAW)",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "windows-x64-debug",
      "displayName": "Windows x64 Debug (MSVC, Ninja)",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "architecture": { "value": "x64", "strategy": "external" },
      "toolset": { "value": "host=x64", "strategy": "external" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CMAKE_C_COMPILER": "cl", "CMAKE_CXX_COMPILER": "cl" }
    },
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 Release (MSVC, Ninja)",
      "inherits": "windows-x64-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "windows-vs2022",
      "displayName": "Windows x64 Visual Studio 2022 solution",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    { "name": "mac-debug",             "configurePreset": "mac-debug" },
    { "name": "mac-asan",              "configurePreset": "mac-asan" },
    { "name": "mac-release",           "configurePreset": "mac-release" },
    { "name": "mac-universal-release", "configurePreset": "mac-universal-release" },
    { "name": "windows-x64-debug",     "configurePreset": "windows-x64-debug" },
    { "name": "windows-x64-release",   "configurePreset": "windows-x64-release" },
    { "name": "windows-vs2022",        "configurePreset": "windows-vs2022", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "mac-debug",             "configurePreset": "mac-debug",             "output": { "outputOnFailure": true } },
    { "name": "mac-asan",              "configurePreset": "mac-asan",              "output": { "outputOnFailure": true } },
    { "name": "mac-release",           "configurePreset": "mac-release",           "output": { "outputOnFailure": true } },
    { "name": "mac-universal-release", "configurePreset": "mac-universal-release", "output": { "outputOnFailure": true } },
    { "name": "windows-x64-debug",     "configurePreset": "windows-x64-debug",     "output": { "outputOnFailure": true } },
    { "name": "windows-x64-release",   "configurePreset": "windows-x64-release",   "output": { "outputOnFailure": true } },
    { "name": "windows-vs2022",        "configurePreset": "windows-vs2022", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
