{
  "schemaVersion": 1,
  "engineVersion": "0.1.0",
  "algorithmVersion": 1,
  "name": "Broadcast Voice - Balanced",
  "description": "Speech-preserving default: 80 Hz HPF, medium expander (threshold 12 dB under the measured speech level, 3:1, 20 dB cap, 40 ms hold), gentle 2.5:1 leveling. Expander threshold is speech-relative (measured per file by the analysis pass); 12 ms transient rejection keeps mouse clicks in pauses from opening it. Original RaDiff starting point (algorithm v1), awaiting listening approval.",
  "author": "RaDiff",
  "signalOrder": [
    "input",
    "eq",
    "expander",
    "compressor1",
    "compressor2",
    "output"
  ],
  "bypass": false,
  "modules": {
    "input": {
      "gainDb": 0.0,
      "dcBlockEnabled": true,
      "highPassEnabled": true,
      "highPassHz": 80.0,
      "highPassSlopeDbOct": 12.0
    },
    "eq": {
      "enabled": true,
      "bands": [
        {
          "enabled": false,
          "type": "lowShelf",
          "frequencyHz": 120.0,
          "gainDb": 0.0,
          "q": 0.7
        },
        {
          "enabled": false,
          "type": "bell",
          "frequencyHz": 300.0,
          "gainDb": 0.0,
          "q": 1.0
        },
        {
          "enabled": false,
          "type": "bell",
          "frequencyHz": 1200.0,
          "gainDb": 0.0,
          "q": 1.0
        },
        {
          "enabled": false,
          "type": "bell",
          "frequencyHz": 3500.0,
          "gainDb": 0.0,
          "q": 1.0
        },
        {
          "enabled": false,
          "type": "highShelf",
          "frequencyHz": 10000.0,
          "gainDb": 0.0,
          "q": 0.7
        }
      ]
    },
    "expander": {
      "enabled": true,
      "thresholdDbfs": -48.0,
      "ratio": 3.0,
      "kneeDb": 6.0,
      "attackMs": 5.0,
      "holdMs": 40.0,
      "releaseMs": 60.0,
      "hysteresisDb": 3.0,
      "detector": "rms",
      "rmsWindowMs": 10.0,
      "sidechainHighPassEnabled": false,
      "sidechainHighPassHz": 100.0,
      "sidechainLowPassEnabled": false,
      "sidechainLowPassHz": 8000.0,
      "lookaheadMs": 15.0,
      "maxAttenuationDb": 20.0,
      "wet": 1.0,
      "stereoLink": true,
      "thresholdMode": "speechRelative",
      "relativeThresholdDb": -12.0,
      "transientRejectMs": 12.0
    },
    "compressor1": {
      "enabled": true,
      "thresholdDbfs": -24.0,
      "ratio": 2.5,
      "kneeDb": 6.0,
      "attackMs": 10.0,
      "releaseMs": 150.0,
      "makeupGainDb": 0.0,
      "detector": "rms",
      "rmsWindowMs": 10.0,
      "sidechainHighPassEnabled": false,
      "sidechainHighPassHz": 100.0,
      "autoRelease": false,
      "wet": 1.0,
      "stereoLink": true
    },
    "compressor2": {
      "enabled": false,
      "thresholdDbfs": -18.0,
      "ratio": 4.0,
      "kneeDb": 3.0,
      "attackMs": 3.0,
      "releaseMs": 80.0,
      "makeupGainDb": 0.0,
      "detector": "peak",
      "rmsWindowMs": 5.0,
      "sidechainHighPassEnabled": false,
      "sidechainHighPassHz": 100.0,
      "autoRelease": false,
      "wet": 1.0,
      "stereoLink": true
    }
